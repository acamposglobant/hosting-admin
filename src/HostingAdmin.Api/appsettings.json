{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Path": "data/hostingadmin.db"
  },
  "Audit": {
    "RetentionDays": 90,
    "PruneIntervalHours": 24
  },
  "Sessions": {
    "AbsoluteLifetime": "12:00:00",
    "IdleTimeout": null,
    "CookieName": "ha_session"
  },
  "Auth": {
    "MaxFailedLoginAttempts": 5,
    "LockoutWindow": "00:15:00"
  },
  "Security": {
    "AllowedOrigins": [
      "https://panel.example.invalid"
    ],
    "CsrfCookieName": "ha_csrf",
    "CsrfHeaderName": "X-CSRF-Token"
  },
  "Bootstrap": {
    "WindowDuration": "00:15:00",
    "MinPasswordLength": 12,
    "MaxPasswordLength": 128
  }
}
