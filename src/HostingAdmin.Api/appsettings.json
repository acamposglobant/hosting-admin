{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Path": "data/hostingadmin.db"
  },
  "Audit": {
    "RetentionDays": 90,
    "PruneIntervalHours": 24
  },
  "Sessions": {
    "AbsoluteLifetime": "12:00:00",
    "IdleTimeout": null,
    "CookieName": "ha_session"
  }
}
