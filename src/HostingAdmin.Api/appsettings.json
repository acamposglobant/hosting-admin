{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Path": "data/hostingadmin.db"
  },
  "Audit": {
    "RetentionDays": 90,
    "PruneIntervalHours": 24
  },
  "Sessions": {
    "AbsoluteLifetime": "12:00:00",
    "IdleTimeout": null,
    "CookieName": "ha_session"
  },
  "Auth": {
    "MaxFailedLoginAttempts": 5,
    "LockoutWindow": "00:15:00"
  },
  "Security": {
    "AllowedOrigins": [
      "https://panel.example.invalid"
    ],
    "CsrfCookieName": "ha_csrf",
    "CsrfHeaderName": "X-CSRF-Token"
  },
  "Bootstrap": {
    "WindowDuration": "00:15:00",
    "MinPasswordLength": 12,
    "MaxPasswordLength": 128
  },
  "Proxy": {
    "RequireAttestation": false,
    "AttestationHeaderName": "X-Proxy-Attestation",
    "AttestationSecret": "",
    "TrustedProxyAddresses": [
      "127.0.0.1",
      "::1"
    ]
  },
  "Services": {
    "UnitNames": [
      "nginx.service",
      "ssh.service"
    ],
    "SystemctlPath": "/usr/bin/systemctl",
    "Timeout": "00:00:02"
  },
  "AgentChannel": {
    "SocketPath": "/run/hostingadmin/agent.sock",
    "SecretFile": "/etc/hostingadmin/agent-shared-secret",
    "CallTimeout": "00:00:05",
    "ProbeTimeout": "00:00:00.750"
  },
  "AuditShipping": {
    "Enabled": false,
    "PollIntervalSeconds": 10,
    "BatchSize": 100
  }
}
